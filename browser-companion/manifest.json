{
  "manifest_version": 3,
  "name": "Proofpage \u2014 Save page evidence",
  "version": "0.2.4",
  "description": "Review page evidence or save original images and PDFs to your local Proofpage library. Runs only when you click.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save page evidence to Proofpage"
  },
  "optional_host_permissions": [
    "http://127.0.0.1/*"
  ],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
