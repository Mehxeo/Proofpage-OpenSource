# Copy to .env; never commit real values. Set DNS before deploying Compose.
PROOFPAGE_DOMAIN=proofpage.example.com
PROOFPAGE_PUBLIC_URL=https://proofpage.example.com
PROOFPAGE_HOSTED_HOME=/data
# Billing is disabled until ALL three are configured. Use a dedicated sandbox first.
PROOFPAGE_STRIPE_KEY=
PROOFPAGE_STRIPE_PRICE_ID=
PROOFPAGE_STRIPE_WEBHOOK_SECRET=
PROOFPAGE_STRIPE_LIVE=false
# Optional operator-managed model endpoint. Free plan cannot invoke it.
PROOFPAGE_MODEL_URL=
PROOFPAGE_MODEL_NAME=
PROOFPAGE_MODEL_KEY=
